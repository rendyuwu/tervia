{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tervia",
  "mainBinaryName": "TEDIApp",
  "version": "0.1.0",
  "identifier": "dev.rendy.tervia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Tervia",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "tedi.desktop",
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "desktopTemplate": "tedi.desktop",
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 rendyuwu. Derived from TEDI © 2026 IlhamriSKY, itself derived from Terax © 2026 Crynta. Apache License 2.0.",
    "licenseFile": "../LICENSE",
    "shortDescription": "Remote machine client",
    "longDescription": "Tervia is a lightweight desktop client for remote machines: SSH sessions, port forwarding, SFTP browsing, and an encrypted backup of your saved connections."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rendyuwu/tervia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RTM5MTA2QTBDOUFEQTgKUldTb3JjbWdCcEhqbUlxbGJ5R01IMTE3UjczSklLM3VxR0VGSFJUZWs3dlljellCaWdVVFVPd20K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
